# ambienti e artefatti
.venv/
node_modules/
frontend/dist/
__pycache__/
*.pyc

# dati locali: il database si ricostruisce con `manage.py rebuild`
*.db

# segreti: mai nel repo
.env
.env.local

# i byte dei parquet Defeatbeta gia' scaricati: si ricostruisce da sola
backend/data/httpfs_cache/

# la watchlist e' TUA e resta sul tuo disco: non finisce nella storia del repo.
#
# Qui c'era scritto che era «l'unico dato che non si ricostruisce» e che per il
# backup bastava copiare questo file. Era vero il giorno in cui e' stato scritto,
# ed e' diventato sbagliato da solo: adesso i file che non si ricostruiscono
# sono sette, fra cui i referti gia' pagati al modello e i documenti SEC
# scaricati a mano. La procedura buona sta nel README, alla voce «Il backup», ed
# e' copiare l'intera cartella `backend/data/` — perche' quella non invecchia.
backend/data/watchlist.json
backend/data/watchlist.json.tmp
backend/data/watchlist_events.jsonl
backend/data/grafici.json
backend/data/referti.jsonl
backend/data/referti.jsonl.prima
backend/data/grafici.json.tmp

# le impostazioni sono TUE: quale modello usi e' una scelta di questa macchina,
# non del progetto. Il predefinito sta in config.py ed e' quello del repo.
backend/data/impostazioni.json
backend/data/impostazioni.json.tmp

# l'elenco degli spin-off: e' una pagina scaricata, si riprende col pulsante
backend/data/spinoff.json
backend/data/spinoff.json.tmp

# i documenti SEC che scarichi tu: sono grossi e sono pubblici,
# il repo non e' il posto giusto per tenerli
backend/data/filings/
